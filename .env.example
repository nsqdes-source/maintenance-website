NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret_here

# Server-only invoice email; configure after verifying the sending domain in Resend.
RESEND_API_KEY=your_resend_api_key_here
RESEND_INVOICE_FROM=مؤسسة أمان للمقاولات <invoices@mail.mueenfix.com>

# Optional Google Drive sync; use a web OAuth client with an authorized redirect URI.
GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=https://www.mueenfix.com/api/drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=base64_encoded_32_random_bytes
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: GA4 Measurement ID. Leave blank until the property is ready.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
